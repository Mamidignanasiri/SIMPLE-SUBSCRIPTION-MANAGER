<!DOCTYPE html>
<html>
<head>
<title>StreamZone OTT + Ticket Manager</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,Arial;
}
body{
background:#0b0b0b;
color:white;
}
header{
background:linear-gradient(90deg,#e50914,#ff4500);
padding:20px;
display:flex;
justify-content:space-between;
align-items:center;
flex-wrap:wrap;
}
.logo{
font-size:35px;
font-weight:bold;
}
.search{
width:35%;
padding:12px;
border-radius:25px;
border:none;
}
button{
background:#e50914;
color:white;
border:none;
padding:12px 20px;
border-radius:20px;
cursor:pointer;
}
button:hover{
background:white;
color:black;
}
.hero{
height:420px;
background:
linear-gradient(#0008,#0008),
url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba")
center/cover;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
}
.hero h1{
font-size:55px;
}
.container{
width:90%;
margin:auto;
padding:30px;
}
.card-container{
display:flex;
gap:20px;
flex-wrap:wrap;
justify-content:center;
}
.card{
background:#1c1c1c;
padding:25px;
width:260px;
border-radius:20px;
text-align:center;
box-shadow:0 0 20px #000;
}
.card:hover{
transform:translateY(-10px);
}
.movies{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:25px;
margin-top:20px;
}
.movie{
background:#222;
padding:15px;
border-radius:15px;
}
.movie img{
width:100%;
height:280px;
object-fit:cover;
border-radius:15px;
}
.section{
background:#171717;
padding:25px;
margin-top:30px;
border-radius:20px;
}
select,input{
padding:12px;
margin:8px;
width:90%;
border-radius:10px;
}
.seats{
display:grid;
grid-template-columns:repeat(5,50px);
gap:10px;
justify-content:center;
}
.seat{
background:#444;
padding:15px;
cursor:pointer;
border-radius:8px;
text-align:center;
}
.selected{
background:green;
}
.ticket{
background:#222;
padding:20px;
border-radius:15px;
margin-top:20px;
}
.dark{
background:white;
color:black;
}
@media(max-width:600px){
.search{
width:90%;
}
.hero h1{
font-size:35px;
}
}
</style>
</head>
<body>
<header>
<div class="logo">🎬 StreamZone</div>
<input class="search" id="search" placeholder="Search movies..." onkeyup="searchMovie()">
<button onclick="darkMode()">🌙</button>
</header>
<section class="hero">
<h1>Unlimited Entertainment</h1>
<p>Movies • OTT • Tickets</p>
<button>Start Now</button>
</section>
<div class="container">
<h2>OTT Subscription Plans</h2>
<div class="card-container">
<div class="card">
<h2>Basic</h2>
<h1>₹199</h1>
<p>HD Streaming</p>
<button onclick="subscribe('Basic')">Subscribe</button>
</div>
<div class="card">
<h2>Standard</h2>
<h1>₹499</h1>
<p>Full HD + 2 Screens</p>
<button onclick="subscribe('Standard')">Subscribe</button>
</div>
<div class="card">
<h2>Premium</h2>
<h1>₹799</h1>
<p>4K + 5 Screens</p>
<button onclick="subscribe('Premium')">Subscribe</button>
</div>
</div>
<div class="section">
<h2>Latest Movies 🍿</h2>
<select id="genre" onchange="filterMovie()">
<option value="all">All</option>
<option>Action</option>
<option>Drama</option>
<option>Sci-Fi</option>
</select>
<div id="movies" class="movies"></div>
</div>
<div class="section">
<h2>🎟 Book Movie Tickets</h2>
<input id="movieName" placeholder="Movie Name">
<input id="customer" placeholder="Customer Name">
<h3>Select Seats</h3>
<div class="seats">
<div class="seat" onclick="seat(this)">A1</div>
<div class="seat" onclick="seat(this)">A2</div>
<div class="seat" onclick="seat(this)">A3</div>
<div class="seat" onclick="seat(this)">A4</div>
<div class="seat" onclick="seat(this)">A5</div>
</div>
<br>
<select id="food">
<option>No Food</option>
<option>Popcorn ₹150</option>
<option>Combo ₹300</option>
</select>
<button onclick="bookTicket()">Book Ticket</button>
</div>
<div class="section">
<h2>My Ticket Collection 🎫</h2>
<div id="tickets"></div>
</div>
<div class="section">
<h2>My Watchlist ❤️</h2>
<div id="watchlist"></div>
</div>
</div>
<script>
let movies=[
{
name:"Avatar 2",
genre:"Sci-Fi",
img:"https://images.unsplash.com/photo-1440404653325-ab127d49abc1",
rating:"⭐⭐⭐⭐⭐"
},
{
name:"Avengers Endgame",
genre:"Action",
img:"https://images.unsplash.com/photo-1536440136628-849c177e76a1",
rating:"⭐⭐⭐⭐⭐"
},
{
name:"RRR",
genre:"Action",
img:"https://images.unsplash.com/photo-1489599849927-2ee91cede3ba",
rating:"⭐⭐⭐⭐"
},
{
name:"Interstellar",
genre:"Sci-Fi",
img:"https://images.unsplash.com/photo-1446776811953-b23d57bd21aa",
rating:"⭐⭐⭐⭐⭐"
},
{
name:"Dangal",
genre:"Drama",
img:"https://images.unsplash.com/photo-1489599849927-2ee91cede3ba",
rating:"⭐⭐⭐⭐"
}
];
let selectedSeat="";
let tickets=[];
function showMovies(data=movies){
let html="";
data.forEach((m)=>{
html+=`
<div class="movie">
<img src="${m.img}">
<h2>${m.name}</h2>
<p>${m.rating}</p>
<button onclick="watch('${m.name}')">❤️ Watchlist</button>
<button onclick="play('${m.name}')">▶ Trailer</button>
</div>
`;
});
moviesBox.innerHTML=html;
}
function subscribe(plan){
alert("You subscribed to "+plan+" Plan");
}
function searchMovie(){
let t=search.value.toLowerCase();
showMovies(movies.filter(m=>m.name.toLowerCase().includes(t)));
}
function filterMovie(){
let g=genre.value;
if(g=="all") showMovies();
else showMovies(movies.filter(m=>m.genre==g));
}
function seat(x){
document.querySelectorAll(".seat").forEach(s=>s.classList.remove("selected"));
x.classList.add("selected");
selectedSeat=x.innerHTML;
}
function bookTicket(){
let price=200;
if(food.value.includes("150")) price+=150;
if(food.value.includes("300")) price+=300;
let id="TKT"+Date.now();
tickets.push({
id:id,
movie:movieName.value,
seat:selectedSeat,
amount:price
});
showTickets();
alert("Ticket Booked Successfully\n"+id);
}
function showTickets(){
let h="";
tickets.forEach(t=>{
h+=`
<div class="ticket">
Ticket ID : ${t.id}
<br>
Movie : ${t.movie}
<br>
Seat : ${t.seat}
<br>
Amount : ₹${t.amount}
</div>
`;
});
ticketsBox.innerHTML=h;
}
function watch(m){
watchlist.innerHTML+="<p>"+m+"</p>";
}
function play(m){
alert("Playing Trailer : "+m);
}
function darkMode(){
document.body.classList.toggle("dark");
}
let moviesBox=document.getElementById("movies");
let ticketsBox=document.getElementById("tickets");
showMovies();
</script>
</body>
</html>
